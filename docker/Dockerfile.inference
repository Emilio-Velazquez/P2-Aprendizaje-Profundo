FROM python:3.10-slim

# Instalar PyTorch CPU
RUN pip install --no-cache-dir torch==2.14.1 --extra-index-url https://download.pytorch.org/whl/cpu

WORKDIR /app

# Instalar dependencias del servicio de inferencia
COPY requirements-infer.txt .
RUN pip install --no-cache-dir -r requirements-infer.txt

# Crear usuario no root para ejecucion segura
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Copiar codigo fuente
COPY --chown=appuser:appuser src ./src

# Copiar artefactos necesarios del modelo campeon
COPY --chown=appuser:appuser model_export/champion/weights.pt /app/model_export/champion/weights.pt
COPY --chown=appuser:appuser model_export/champion/scaler.json /app/model_export/champion/scaler.json
COPY --chown=appuser:appuser model_export/champion/feature_names.json /app/model_export/champion/feature_names.json
COPY --chown=appuser:appuser model_export/champion/env_info.json /app/model_export/champion/env_info.json

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MODEL_DIR=/app/model_export/champion

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "--factory", "src.inference.app:create_app_from_env", "--host", "0.0.0.0", "--port", "8000"]
